# ==============================
# Server Configuration
# ==============================
PORT=3000

# ==============================
# Security & Access
# ==============================
# PIN Darurat 2-Langkah untuk memicu/mematikan tombol panik.
#
# WAJIB DIISI SENDIRI — tidak ada lagi nilai bawaan di kode. Selama kosong,
# tombol darurat menolak bekerja dan menjawab 503; sisa aplikasi tetap jalan.
#
# JANGAN pakai 1234. Angka itu dulu menjadi nilai bawaan dan tertulis di berkas
# ini, jadi memakainya sama saja dengan tidak memakai PIN sama sekali.
EMERGENCY_PIN=
# Origin yang diizinkan untuk CORS (untuk production gunakan domain frontend, misal https://rt.com)
CORS_ORIGIN=*

# ==============================
# PostgreSQL Database
# ==============================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_community_rt

# ==============================
# JWT Secret
# ==============================
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_minimal_32_karakter
# Umur token sesi. 24 jam, bukan 7 hari: token tersimpan di localStorage pada
# Web, jadi satu kebocoran = akses selama umur token ini. Sejak Fase B sesi juga
# bisa diputus lewat tombol Keluar (users.token_versi), tetapi umur pendek tetap
# lapis pertamanya.
JWT_EXPIRES_IN=24h

# Umur tiket unduh sekali pakai, dalam detik. Tombol Export tidak lagi menempel
# token ke URL; ia menukar sesi menjadi tiket berumur pendek yang hanya membuka
# satu unduhan. Pendek dengan sengaja — ia cuma perlu bertahan satu klik.
# Boleh dikosongkan: bawaannya 60.
TIKET_UNDUH_DETIK=60

# Kompatibilitas klien lama: apakah token masih boleh dibawa lewat `?token=`.
#
# Bawaannya `true` (permisif) dan itu disengaja — klien produksi yang sedang
# berjalan masih memakai jalur itu, dan deploy yang lupa mengisi baris ini tidak
# boleh mematikan setiap tombol Export di produksi.
#
# Setel `false` HANYA setelah Flutter Web produksi terbukti memakai tiket unduh.
# Penandanya ada di log: selama baris `[LEGACY] ?token= masih dipakai` masih
# muncul, masih ada klien lama di luar sana. Mematikannya juga mencabut
# GET /reset/cadangan, yang memang hanya berguna lewat jalur ini.
IZINKAN_TOKEN_QUERY=true

# ==============================
# WebSocket (untuk Panic Button / IoT)
# ==============================
# WS_PORT sama dengan PORT (upgrade dari HTTP)

# ==============================
# Iuran air bermeteran — dua tanggal yang membentuk satu periode
# ==============================
# Keduanya boleh dikosongkan; bawaannya 5 dan 25.
#
# Tanggal 1 sampai BATAS_INPUT_METERAN: warga mengisi meterannya sendiri dan
# boleh mengubah langganan sampahnya. Sesudah itu terkunci untuk warga —
# pengurus tetap bisa mengoreksi, dengan alasan yang tercatat.
BATAS_INPUT_METERAN=5

# TANGGAL_TERBIT_TAGIHAN: penjadwal menerbitkan tagihan periode berjalan pada
# tanggal ini ke atas. Pemeriksaannya HARIAN, bukan sekali tepat di tanggal itu
# — instance yang kebetulan mati pada hari itu akan melewatkan tagihan sebulan
# penuh tanpa satu pun gejala.
TANGGAL_TERBIT_TAGIHAN=25

# Keduanya bisa disetel supaya alur ini dapat diuji tanpa menunggu kalender.
# Pengujian yang menuntut orang menunggu tanggal 6 tidak akan pernah dijalankan
# siapa pun. Untuk mencoba input meteran di luar tanggal 1-5, jalankan backend
# dengan BATAS_INPUT_METERAN=31 — lalu kembalikan ke 5.

# Zona waktu dan jadwal cron penjadwal. Server bisa berjalan di UTC, RT-nya
# tidak; tanpa zona eksplisit "tanggal 25" bergeser tujuh jam.
TZ_SCHEDULER=Asia/Jakarta

# Zona waktu SESI DATABASE, dipaksakan pada setiap koneksi pool.
#
# Hampir semua kolom waktu bertipe `timestamp without time zone`, yang menyimpan
# jam dinding menurut zona sesi. Tanpa baris ini, Railway (UTC) menyimpan waktu
# tujuh jam lebih awal daripada mesin pengembangan (UTC+7) — tanpa satu pun
# galat, dan pengujian lokal tetap lulus.
#
# Boleh dikosongkan: bawaannya Asia/Jakarta.
DB_TIMEZONE=Asia/Jakarta
CRON_TAGIHAN=0 2 * * *

# ==============================
# Midtrans Payment Gateway (iuran warga)
# ==============================
# Ambil di dashboard Midtrans -> Settings -> Access Keys.
# Selama pengujian pakai kunci SANDBOX (berawalan SB-Mid-), bukan Production.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# true HANYA bila sudah siap memakai uang sungguhan, dan backend sudah HTTPS.
MIDTRANS_IS_PRODUCTION=false

# Halaman yang dibuka Snap setelah pembayaran selesai.
MIDTRANS_FINISH_URL=http://localhost:3001/api/payments/selesai

# ==============================
# WhatsApp Gateway (Fonnte) — penagihan iuran & notifikasi
# ==============================
# Ambil di dashboard Fonnte (https://fonnte.com) -> token device.
# Selama kosong, whatsapp.service mengirim SIMULASI (log ke console) —
# aplikasi tetap jalan, tetapi warga tidak benar-benar menerima WA.
FONNTE_TOKEN=

# Webhook: daftarkan URL berikut di dashboard Midtrans ->
#   Settings -> Configuration -> Payment Notification URL
#   https://<alamat-publik>/api/payments/notifikasi
# Selama backend masih di jaringan lokal, pakai ngrok: ngrok http 3001

# ==============================
# MQTT — perintah alarm ke perangkat
# ==============================
# Backend menerbitkan "ON"/"OFF" ke topik di bawah; ESP32 berlangganan topik itu.
# Kredensial ini TIDAK PERNAH dikirim ke Flutter/Web: klien memanggil endpoint
# HTTP biasa, dan server ini yang menerbitkan ke broker.
#
# Dikosongkan berarti tombol darurat NONAKTIF dan endpoint alarm menjawab 503
# yang menyebut sebabnya. Sengaja tidak menjatuhkan seluruh server hanya karena
# satu variabel belum diisi.
#
# Contoh: mqtts://broker.contoh.com:8883  (TLS)  atau  mqtt://192.168.1.10:1883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ALARM=smart-community/alarm/command
